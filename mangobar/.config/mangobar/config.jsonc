{
	"modules-left": [ "clock#time","clock#date"],
	"modules-center": ["workspaces"],
	"modules-right": ["tray","pulseaudio","network", "battery"],
  "height": 20,


	"workspaces": {
		"hide-empty": true,
		"pinned": [1, 2, 3, 4, 5],
		"tag-names": ["󰝤", "󰝤", "󰝤", "󰝤", "󰝤"],
		"overview-label": "OVERVIEW",
		"on-click": "activate",
		"on-click-right": "toggle",
		"scroll-interval": 100,
		"on-scroll-up": "mmsg dispatch viewtoleft_have_client",
		"on-scroll-down": "mmsg dispatch viewtoright_have_client"
	},
	"battery": {
		"icons":["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
		"icon":"󰚥",
		"format":"{icon} {percent}%"
	},
	"network": {
		"format": "{icon}",
		"format-wifi": "{signal}",
		"format-disconnected": "{icon}",
		"icon-wifi": "󰖩",
		"icon-ethernet": "󰈀",
		"icon-disconnected": "󰖪",
		"signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
	},
	"pulseaudio": {
		"format": "{icon}  {volume}%",
		"format-muted": " {volume}% {bt}",
		"icons": ["", "", "", "", "", "", "", ""],
		"icon-bluetooth": "󰂯",
		"on-click": "pamixer -t",
		"on-scroll-up": "pamixer -i 2",
		"on-scroll-down": "pamixer -d 2"
	},
	"tray":{
		"icon-size": 25,
		"spacing": 10
	},
  "clock#date":{

    "format": "%d/%m/%Y"
  }
}
