default partial alphanumeric_keys
xkb_symbols "basic" {
    include "us(basic)"
    name[Group1] = "English (US, Turkish AltGr)";

    key <AD08> { [ i, I, idotless, Iabovedot ] };  // AltGr+i = ı, AltGr+Shift+i = İ
    key <AC02> { [ s, S, scedilla, Scedilla ] };   // AltGr+s = ş, Ş
    key <AB03> { [ c, C, ccedilla, Ccedilla ] };   // AltGr+c = ç, Ç
    key <AD07> { [ u, U, udiaeresis, Udiaeresis ] }; // AltGr+u = ü, Ü
    key <AD09> { [ o, O, odiaeresis, Odiaeresis ] }; // AltGr+o = ö, Ö
    key <AC05> { [ g, G, gbreve, Gbreve ] };       // AltGr+g = ğ, Ğ

    include "level3(ralt_switch)"
};
